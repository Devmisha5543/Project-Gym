# PostgreSQL connection (use DATABASE_URL or DB_PASSWORD)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/gym_db
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret

# Redis connection (optional, defaults to localhost:6379)
REDIS_URL=redis://localhost:6379/0

# Frontend URL used to build password-reset links
FRONTEND_URL=http://localhost:5173

# Local Mailpit defaults. Set SMTP_USER, SMTP_PASSWORD, and SMTP_USE_TLS for a real SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
SMTP_USE_TLS=false
